{
  "name": "codemind-ai",
  "displayName": "CodeMind AI",
  "description": "Local AI coding assistant powered by Ollama",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:codemind-ai.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codemind-ai",
          "title": "CodeMind",
          "icon": "media/codemind.svg"
        }
      ]
    },
    "views": {
      "codemind-ai": [
        {
          "id": "codemind-ai.chatView",
          "name": "CodeMind Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "codemind-ai.openChat",
        "title": "CodeMind: Open Chat"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
